-- En yakın oyuncu fonksiyonu
local function getClosest()
    local closest, minDist = nil, 150
    local mpos = Vector2.new(mouse.X, mouse.Y)
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= plr and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local root = p.Character.HumanoidRootPart
            local screen, onScreen = cam:WorldToViewportPoint(root.Position)
            if onScreen then
                local dist = (Vector2.new(screen.X, screen.Y) - mpos).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = p
                end
            end
        end
    end
    return closest
end

-- Tuşlar
uis.InputBegan:Connect(function(input, gp)
    if gp then return end
    
    if input.KeyCode == Enum.KeyCode.T then
        if mouse.Hit and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            plr.Character.HumanoidRootPart.CFrame = mouse.Hit + Vector3.new(0,3,0)
        end
        
    elseif input.KeyCode == Enum.KeyCode.L then
        lockEnabled = not lockEnabled
        if lockEnabled then
            lockTarget = getClosest()
            if lockTarget then
                info.Text = "T : TP    L : LOCK ON ON\nF : STICK BEHIND"
                info.TextColor3 = Color3.fromRGB(180, 120, 255)
            else
                lockEnabled = false
                info.Text = "T : TP    L : LOCK ON\nF : STICK BEHIND"
                info.TextColor3 = Color3.fromRGB(220, 220, 240)
            end
        else
            lockTarget = nil
            info.Text = "T : TP    L : LOCK ON OFF\nF : STICK BEHIND"
            info.TextColor3 = Color3.fromRGB(220, 220, 240)
        end
        
    elseif input.KeyCode == Enum.KeyCode.F then
        stickEnabled = not stickEnabled
        if stickEnabled then
            stickTarget = getClosest()
            if stickTarget then
                info.Text = "T : TP    L : LOCK ON\nF : STICK BEHIND ON"
                info.TextColor3 = Color3.fromRGB(200, 100, 255)
            else
                stickEnabled = false
                info.Text = "T : TP    L : LOCK ON\nF : STICK BEHIND"
                info.TextColor3 = Color3.fromRGB(220, 220, 240)
            end
        else
            stickTarget = nil
            info.Text = "T : TP    L : LOCK ON\nF : STICK BEHIND OFF"
            info.TextColor3 = Color3.fromRGB(220, 220, 240)
        end
    end
end)

-- Lock camera
rs.RenderStepped:Connect(function()
    if lockEnabled and lockTarget and lockTarget.Character then
        local root = lockTarget.Character:FindFirstChild("HumanoidRootPart")
        if root then
            cam.CFrame = CFrame.new(cam.CFrame.Position, root.Position + Vector3.new(0,1.5,0))
        else
            lockEnabled = false
            lockTarget = nil
            info.Text = "T : TP    L : LOCK ON OFF\nF : STICK BEHIND"
            info.TextColor3 = Color3.fromRGB(220, 220, 240)
        end
    end
end)

-- Arkadan yapışma
local DESIRED_DISTANCE = 6.5

rs.Heartbeat:Connect(function()
    if not stickEnabled then return end
    if not stickTarget or not stickTarget.Character then
        stickEnabled = false
        stickTarget = nil
        info.Text = "T : TP    L : LOCK ON\nF : STICK BEHIND OFF"
        info.TextColor3 = Color3.fromRGB(220, 220, 240)
        return
    end
    
    local targetRoot = stickTarget.Character:FindFirstChild("HumanoidRootPart")
    local myRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    
    if not targetRoot or not myRoot then return end
    
    local lookVector = targetRoot.CFrame.LookVector
    local behindPos = targetRoot.Position - (lookVector * DESIRED_DISTANCE)
    behindPos = behindPos + Vector3.new(0, 2, 0)
    
    myRoot.CFrame = CFrame.new(behindPos, targetRoot.Position)
end)

print("Ufenss HUB yüklendi → Teşekkür sadece dc : ufenss | ON/OFF aktif")
